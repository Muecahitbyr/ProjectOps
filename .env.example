# Development-Konfiguration (lokal, `npm run dev`). Fuer Production siehe
# .env.production.example + docker-compose.production.yml - dort gelten
# strengere Regeln (z.B. JWT_ACCESS_SECRET erforderlich, NODE_ENV=production).
NODE_ENV=development
PORT=4000
CHECK_INTERVAL_MS=30000

# Erlaubte Frontend-Origin(s) fuer CORS, kommagetrennt. Kein Wildcard in
# Production - hier explizit die echte Frontend-Domain eintragen.
CORS_ORIGIN=http://localhost:5173

# Auftragspunkt 1 "Echtes Auth-System": Signaturschluessel fuer Access-Token-
# JWTs (siehe config/auth.config.ts). Im Development optional - ohne Wert
# wird ein zufaelliges, nur fuer diesen Prozess gueltiges Secret erzeugt
# (Sitzungen ueberleben dann keinen Neustart). In Production ZWINGEND
# erforderlich (min. 32 Zeichen) - Start bricht sonst kontrolliert ab.
# Erzeugen z.B. mit: openssl rand -hex 32
JWT_ACCESS_SECRET=

# PostgreSQL (siehe docker-compose.yml)
POSTGRES_USER=projectops
POSTGRES_PASSWORD=projectops
POSTGRES_DB=projectops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://projectops:projectops@localhost:5432/projectops

# E-Mail-Benachrichtigungen (SMTP). Ohne diese Werte werden E-Mails
# uebersprungen und nur als FAILED in der notifications-/notification_events-
# Tabelle protokolliert.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProjectOps <noreply@projectops.local>
ALERT_EMAIL_TO=

# Claude (KI-Ursachenanalyse bei OFFLINE-Meldungen)
ANTHROPIC_API_KEY=

# Firebase (firebase-status/firestore Checks). Pro ueberwachtem Firebase-Projekt
# eine Variable, Name = FIREBASE_SERVICE_ACCOUNT_<PROJECT_ID in GROSSBUCHSTABEN,
# Bindestriche zu Unterstrichen>. Wert = Service-Account-JSON, base64-kodiert
# (z.B. `base64 -i service-account.json`).
# FIREBASE_SERVICE_ACCOUNT_RECHNO=
# FIREBASE_SERVICE_ACCOUNT_DRIVECONNECT=

# Stripe (stripe Check)
STRIPE_SECRET_KEY=
