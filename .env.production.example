# Production-Konfiguration fuer docker-compose.production.yml. Kopieren nach
# .env.production und ausfuellen - diese Datei wird NICHT ins Image gebacken
# (siehe .dockerignore), sondern zur Laufzeit per env_file eingelesen.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.production.yml up -d --build

# --- Pflichtfelder ------------------------------------------------------
# Starkes, zufaelliges Passwort fuer die Produktionsdatenbank.
POSTGRES_PASSWORD=

# JWT-Signaturschluessel fuer Access-Token (min. 32 Zeichen) - der Start
# bricht ohne diesen Wert kontrolliert ab (siehe config/auth.config.ts).
# Erzeugen mit: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Verschluesselungsschluessel fuer gespeicherte Webhook-Secrets (min. 32
# Zeichen) - der Start bricht ohne diesen Wert kontrolliert ab (siehe
# core/crypto.ts). Erzeugen mit: openssl rand -hex 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Die tatsaechliche oeffentliche Domain, unter der ProjectOps erreichbar
# ist (z.B. https://projectops.example.com). Wird fuer CORS und die
# httpOnly-Cookie-Sicherheit (secure=true in Production) verwendet.
CORS_ORIGIN=https://your-domain.example

# --- Optional -------------------------------------------------------------
POSTGRES_USER=projectops
POSTGRES_DB=projectops
HTTP_PORT=80
# HTTPS_PORT=443

CHECK_INTERVAL_MS=30000

# E-Mail-Benachrichtigungen (SMTP) - ohne diese Werte werden E-Mails
# uebersprungen und nur als FAILED protokolliert (kein Hard-Fail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProjectOps <noreply@your-domain.example>
ALERT_EMAIL_TO=

# Push-Benachrichtigungen aufs Handy ueber ntfy.sh (kostenlose App, kein
# Account noetig; alternativ ein selbst gehosteter ntfy-Server via
# NTFY_BASE_URL). Eigenes, nicht erratbares Topic waehlen (wirkt wie ein
# Passwort), z.B. per `openssl rand -hex 16`, und in der ntfy-App
# abonnieren. Ohne NTFY_TOPIC wird Push uebersprungen und nur als FAILED
# protokolliert (kein Hard-Fail), wie bei fehlender SMTP-Konfiguration oben.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh

# Claude (KI-Ursachenanalyse bei OFFLINE-Meldungen)
ANTHROPIC_API_KEY=

# Firebase (firebase-status/firestore Checks), siehe .env.example fuer das
# Namensschema.
# FIREBASE_SERVICE_ACCOUNT_RECHNO=

# Stripe (stripe Check)
STRIPE_SECRET_KEY=

# --- Frontend Build-Arg -----------------------------------------------------
# Leer lassen, solange Frontend+Backend ueber denselben Reverse Proxy unter
# derselben Origin laufen (Standardfall, siehe docker-compose.production.yml).
VITE_API_URL=

# Nur setzen, wenn die App ueber eine externe Rewrite-Regel (z.B. Vercel
# "rewrites") unter einem Unterpfad einer anderen Domain ausgeliefert wird,
# statt selbst den Domain-Root zu bedienen (z.B. "/office" fuer
# https://example.com/office). Steuert Router-Basename, Vite-Asset-Praefix
# UND den Refresh-Token-Cookie-Pfad (auth.config.ts) - alle drei muessen
# konsistent sein, daher genuegt diese eine Variable. Leer = normales
# Root-Deployment (Standardfall).
VITE_BASE_PATH=
