# Production-Konfiguration fuer docker-compose.production.yml. Kopieren nach
# .env.production und ausfuellen - diese Datei wird NICHT ins Image gebacken
# (siehe .dockerignore), sondern zur Laufzeit per env_file eingelesen.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.production.yml up -d --build

# --- Pflichtfelder ------------------------------------------------------
# Starkes, zufaelliges Passwort fuer die Produktionsdatenbank.
POSTGRES_PASSWORD=

# JWT-Signaturschluessel fuer Access-Token (min. 32 Zeichen) - der Start
# bricht ohne diesen Wert kontrolliert ab (siehe config/auth.config.ts).
# Erzeugen mit: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Die tatsaechliche oeffentliche Domain, unter der ProjectOps erreichbar
# ist (z.B. https://projectops.example.com). Wird fuer CORS und die
# httpOnly-Cookie-Sicherheit (secure=true in Production) verwendet.
CORS_ORIGIN=https://your-domain.example

# --- Optional -------------------------------------------------------------
POSTGRES_USER=projectops
POSTGRES_DB=projectops
HTTP_PORT=80
# HTTPS_PORT=443

CHECK_INTERVAL_MS=30000

# E-Mail-Benachrichtigungen (SMTP) - ohne diese Werte werden E-Mails
# uebersprungen und nur als FAILED protokolliert (kein Hard-Fail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProjectOps <noreply@your-domain.example>
ALERT_EMAIL_TO=

# Claude (KI-Ursachenanalyse bei OFFLINE-Meldungen)
ANTHROPIC_API_KEY=

# Firebase (firebase-status/firestore Checks), siehe .env.example fuer das
# Namensschema.
# FIREBASE_SERVICE_ACCOUNT_RECHNO=

# Stripe (stripe Check)
STRIPE_SECRET_KEY=

# --- Frontend Build-Arg -----------------------------------------------------
# Leer lassen, solange Frontend+Backend ueber denselben Reverse Proxy unter
# derselben Origin laufen (Standardfall, siehe docker-compose.production.yml).
VITE_API_URL=
